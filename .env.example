# MongoDB (same database as the server)
MONGODB_URI=
DB_NAME=salonbook

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared with the Express server for JWT signing/verification
JWT_SECRET=

# ImgBB (primary image host, server-side only)
IMGBB_API_KEY=

# Cloudinary (optional fallback, used only if ImgBB refuses an upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Express API base URL (public)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
