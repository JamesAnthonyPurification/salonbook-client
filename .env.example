# MongoDB (same database as the server)
MONGODB_URI=
DB_NAME=salonbook

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared with the Express server for JWT signing/verification
JWT_SECRET=

# ImgBB (server-side only, never exposed to the browser)
IMGBB_API_KEY=

# Express API base URL (public)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
